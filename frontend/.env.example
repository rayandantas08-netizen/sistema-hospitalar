# ========== MODO 1: Com Backend (Render, Vercel, Local) ==========
# Use quando tem backend Node rodando
# Local: http://localhost:3000/api
# Render: https://seu-app.onrender.com/api
# Vercel: /api (mesmo domínio)
VITE_API_URL=http://localhost:3000/api

# Base path para GitHub Pages
# Se repo é https://usuario.github.io/sistema-hospitalar/, use /sistema-hospitalar/
# Se Vercel/Render/domínio próprio, use /
VITE_BASE_PATH=/sistema-hospitalar/

# ========== MODO 2: GitHub Pages ONLY (sem backend) ==========
# Para rodar SÓ no GitHub Pages, sem servidor extra
# Frontend fala DIRETO com Supabase
# Deixe VITE_API_URL vazio e configure abaixo:

# URL do seu projeto Supabase (pegue em https://supabase.com/dashboard/project/ohllteerhgvcewwvktua/settings/api)
VITE_SUPABASE_URL=https://ohllteerhgvcewwvktua.supabase.co

# Chave anon publica (NÃO é service_role!)
VITE_SUPABASE_KEY=sua-chave-anon-publica-aqui

# Força modo direto (opcional, detecta automático no github.io)
VITE_USE_SUPABASE_DIRECT=false
