# Copie para .env.local (ou exporte no shell/CI) se quiser sobrescrever os padrões.
# Nenhuma destas variáveis é obrigatória — sem elas o frontend usa os padrões abaixo.

# URL da API do backend (padrão em dev: http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# Subdiretório base do build (GitHub Pages publica em /<nome-do-repo>/).
# Só afeta `npm run build`; em `npm run dev` a base é sempre "/".
VITE_BASE_PATH=/sistema-hospitalar/
