# URL da API backend
# Local: http://localhost:3000/api
# Produção (Render): https://seu-backend.onrender.com/api
# Se backend e frontend estão no mesmo servidor, use /api
VITE_API_URL=http://localhost:3000/api

# Base path para GitHub Pages
# Se seu repo é https://usuario.github.io/sistema-hospitalar/, use /sistema-hospitalar/
# Se for domínio próprio ou Vercel, use /
VITE_BASE_PATH=/sistema-hospitalar/
