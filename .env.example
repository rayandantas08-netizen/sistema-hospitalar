# Copie para .env (local) ou cadastre em Render > Environment (produção).
# As três primeiras são OBRIGATÓRIAS: sem elas a API aborta a inicialização.
SUPABASE_URL=sua-url-supabase
SUPABASE_KEY=sua-chave-anon-supabase
SUPABASE_SERVICE_KEY=sua-service-role-key-supabase

JWT_SECRET=sua-chave-secreta-jwt
ADMIN_SECRET=seu-secret-para-criar-admin
GROQ_API_KEY=sua-chave-groq

# Opcionais (têm padrão no código)
# PORT=3000        # no Render é injetado automaticamente
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Painel de TV (chamada de pacientes)
# ---------------------------------------------------------------------------
# A TV da recepção não tem ninguém para digitar login. Se você definir este
# token, os endpoints de LEITURA do painel passam a aceitar
#   - header  x-painel-token: <token>
#   - query   ?token=<token>            (o EventSource não envia headers)
# SOMENTE estes endpoints aceitam o token do painel:
#   GET /api/chamadas/ultimas | /api/chamadas/eventos | /api/chamadas/realtime
# Se a variável NÃO for definida, o token fica desativado e o painel precisa de
# um JWT normal (comportamento padrão, mais seguro).
# PAINEL_TV_TOKEN=troque-por-um-token-longo-e-aleatorio

# ---------------------------------------------------------------------------
# Seed inicial (npm run seed)
# ---------------------------------------------------------------------------
# O administrador principal é criado no Supabase Auth (senha encriptada em
# bcrypt pelo GoTrue). Sem estas duas variáveis o seed cria apenas a estrutura
# física (unidade, salas e leitos) e avisa que o admin foi ignorado.
# SEED_ADMIN_EMAIL=admin@hospital.com
# SEED_ADMIN_PASSWORD=uma-senha-forte-com-8-ou-mais-caracteres
# SEED_ADMIN_NOME=Administrador Principal
# SEED_ADMIN_CPF=12345678901
# SEED_ADMIN_CNS=123456789012345
# SEED_ADMIN_TELEFONE=11999999999
